# 브리지 설정 예시. 실제 값은 `npm run setup-token`이 만드는 .env에 들어가며, .env는 git에 올라가지 않는다.
# API 키(ANTHROPIC_API_KEY, OPENAI_API_KEY 등)는 절대 넣지 않는다. 넣어도 AI 프로세스에는 전달되지 않는다.

# 브리지 포트. 브리지는 항상 127.0.0.1에만 열리고, 휴대폰은 `tailscale serve`를 거쳐 접속한다.
BRIDGE_PORT=8787

# Android 앱과 공유하는 접근 토큰. setup-token이 무작위로 만든다. 직접 적지 않는다.
BRIDGE_APP_TOKEN=

# 모델. 비워 두면 각 구독의 기본 모델을 쓴다.
CLAUDE_ANALYSIS_MODEL=sonnet
CLAUDE_WRITING_MODEL=opus
CODEX_ANALYSIS_MODEL=
CODEX_WRITING_MODEL=
